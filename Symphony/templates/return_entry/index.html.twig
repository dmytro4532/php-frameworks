{% extends 'base.html.twig' %}

{% block title %}ReturnEntry index{% endblock %}

{% block body %}
    <h1>ReturnEntry index</h1>

    <form method="get" class="mb-3">
        <input type="text" name="id" value="{{ filters.id }}" placeholder="Filter by ID">
        <input type="date" name="returnedAt" value="{{ filters.returnedAt }}" placeholder="Returned At">
        <select name="itemsPerPage">
            {% for n in [5, 10, 20, 50] %}
                <option value="{{ n }}" {% if itemsPerPage == n %}selected{% endif %}>{{ n }} per page</option>
            {% endfor %}
        </select>
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>ReturnedAt</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for return_entry in return_entries %}
            <tr>
                <td>{{ return_entry.id }}</td>
                <td>{{ return_entry.returnedAt ? return_entry.returnedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_return_entry_show', {'id': return_entry.id}) }}">show</a>
                    <a href="{{ path('app_return_entry_edit', {'id': return_entry.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div>
        {% for i in 1..totalPages %}
            <a href="{{ path('app_return_entry_index', app.request.query.all|merge({'page': i})) }}"
               {% if i == currentPage %}style="font-weight: bold;"{% endif %}>
                {{ i }}
            </a>
        {% endfor %}
    </div>

    <a href="{{ path('app_return_entry_new') }}">Create new</a>
{% endblock %}
