{% extends 'base.html.twig' %}

{% block title %}Book index{% endblock %}

{% block body %}
    <h1>Book index</h1>

    <form method="get" class="mb-3">
        <input type="text" name="id" value="{{ filters.id }}" placeholder="Filter by ID">
        <input type="text" name="title" value="{{ filters.title }}" placeholder="Filter by Title">
        <select name="itemsPerPage">
            {% for n in [5, 10, 20, 50] %}
                <option value="{{ n }}" {% if itemsPerPage == n %}selected{% endif %}>{{ n }} per page</option>
            {% endfor %}
        </select>
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>
                    <a href="{{ path('app_book_show', {'id': book.id}) }}">show</a>
                    <a href="{{ path('app_book_edit', {'id': book.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div>
        {% for i in 1..totalPages %}
            <a href="{{ path('app_book_index', app.request.query.all|merge({'page': i})) }}"
               {% if i == currentPage %}style="font-weight: bold;"{% endif %}>{{ i }}</a>
        {% endfor %}
    </div>

    <a href="{{ path('app_book_new') }}">Create new</a>
{% endblock %}
