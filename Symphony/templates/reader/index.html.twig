{% extends 'base.html.twig' %}

{% block title %}Reader index{% endblock %}

{% block body %}
    <h1>Reader index</h1>

    <form method="get" class="mb-3">
        <input type="text" name="id" value="{{ filters.id }}" placeholder="Filter by ID">
        <input type="text" name="fullName" value="{{ filters.fullName }}" placeholder="Filter by Full Name">
        <input type="text" name="email" value="{{ filters.email }}" placeholder="Filter by Email">
        <select name="itemsPerPage">
            {% for n in [5, 10, 20, 50] %}
                <option value="{{ n }}" {% if itemsPerPage == n %}selected{% endif %}>{{ n }} per page</option>
            {% endfor %}
        </select>
        <button type="submit">Filter</button>
    </form>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for reader in readers %}
            <tr>
                <td>{{ reader.id }}</td>
                <td>{{ reader.fullName }}</td>
                <td>{{ reader.email }}</td>
                <td>
                    <a href="{{ path('app_reader_show', {'id': reader.id}) }}">show</a>
                    <a href="{{ path('app_reader_edit', {'id': reader.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div>
        {% for i in 1..totalPages %}
            <a href="{{ path('app_reader_index', app.request.query.all|merge({'page': i})) }}"
               {% if i == currentPage %}style="font-weight: bold;"{% endif %}>
                {{ i }}
            </a>
        {% endfor %}
    </div>

    <a href="{{ path('app_reader_new') }}">Create new</a>
{% endblock %}
